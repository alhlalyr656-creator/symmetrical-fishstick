<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>النجمة للأثاث | الطائف</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Reem+Kufi:wght@500;700&family=Noto+Naskh+Arabic:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#F6EFE0;--surface:#FFFAF0;--ink:#2B1D12;--muted:#6B5843;--gold:#B8893A;--gold-d:#8A6420;--line:#E0D2B4;--on-gold:#FFFAF0;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1E1610;--surface:#2A1F16;--ink:#F3E9D6;--muted:#C2AF93;--gold:#D4A64F;--gold-d:#E4BC6B;--line:#4A3826;--on-gold:#1E1610}}
:root[data-theme="dark"]{--bg:#1E1610;--surface:#2A1F16;--ink:#F3E9D6;--muted:#C2AF93;--gold:#D4A64F;--gold-d:#E4BC6B;--line:#4A3826;--on-gold:#1E1610}
html{scroll-behavior:smooth;scroll-padding-top:calc(64px + env(safe-area-inset-top,0px))}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Noto Naskh Arabic",serif;font-size:18px;line-height:1.9}
h1,h2,h3,.btn,nav a{font-family:"Reem Kufi",sans-serif}
a{color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);border-bottom:1px solid var(--gold)}
.bar{max-width:1080px;margin:auto;display:flex;align-items:center;gap:16px;padding:8px 20px}
.brand{display:flex;align-items:center;gap:10px;font-family:"Reem Kufi";font-weight:700;font-size:20px;text-decoration:none;white-space:nowrap}
.brand svg{width:30px;height:30px;color:var(--gold)}
nav{display:flex;gap:4px;overflow-x:auto;margin-inline-start:auto}
nav a{padding:6px 12px;text-decoration:none;font-size:16px;color:var(--muted);white-space:nowrap}
nav a:hover{color:var(--gold-d)}
section{max-width:1080px;margin:auto;padding:64px 20px}
h2{font-size:32px;margin:0 0 8px;font-weight:700}
.lead{color:var(--muted);margin:0 0 32px;max-width:60ch}
.hero{position:relative;overflow:hidden;padding-top:72px;padding-bottom:80px}
.hero .star{position:absolute;inset-inline-end:-140px;top:-40px;width:520px;max-width:none;color:var(--gold);opacity:.16}
.hero>*{position:relative}
.hero h1{font-size:clamp(44px,9vw,84px);line-height:1.2;margin:0 0 16px;font-weight:700}
.hero p{max-width:46ch;color:var(--muted);font-size:20px}
.rate{display:inline-block;border:1px solid var(--gold);padding:2px 14px;margin-bottom:20px;color:var(--gold-d);font-size:16px}
.btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.btn{display:inline-block;padding:11px 26px;font-size:18px;text-decoration:none;border:1.5px solid var(--gold);background:none;color:var(--ink);cursor:pointer}
.btn.fill{background:var(--gold);color:var(--on-gold)}
.btn:hover{background:var(--gold-d);color:var(--on-gold);border-color:var(--gold-d)}
.cats{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
.cat{display:flex;align-items:center;gap:16px;border:1px solid var(--line);background:var(--surface);padding:22px;text-decoration:none}
.cat span{font-size:40px}.cat h3{margin:0;font-size:22px}.cat small{color:var(--muted);font-size:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:22px}
.card{background:var(--surface);border:1px solid var(--line);display:flex;flex-direction:column}
.pic{aspect-ratio:4/3;display:grid;place-items:center;border-bottom:1px solid var(--line)}
.pic svg{width:62%}
.card .in{padding:16px 18px 20px;display:flex;flex-direction:column;gap:6px;flex:1}
.card h3{margin:0;font-size:21px}
.price{color:var(--gold-d);font-weight:700}
.card p{margin:0;color:var(--muted);font-size:16px;line-height:1.7}
.spec{font-size:15px;color:var(--muted);border-top:1px dashed var(--line);padding-top:8px;line-height:1.7}
.card .btn{margin-top:auto;text-align:center;font-size:16px;padding:8px}
.alt{background:var(--surface);border-block:1px solid var(--line)}
.alt section{padding-block:56px}
.tools{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin:8px 0 20px}
label{display:flex;flex-direction:column;font-size:16px;color:var(--muted);gap:4px}
input,select{font:inherit;font-size:17px;padding:8px 10px;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:0}
.about{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:28px}
.about h3{margin:0 0 4px;font-size:21px;color:var(--gold-d)}.about p{margin:0;color:var(--muted)}
.contact{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px}
.contact dl{margin:0}.contact dt{color:var(--gold-d);font-family:"Reem Kufi";margin-top:12px}.contact dd{margin:0}
footer{text-align:center;padding:28px 20px;border-top:1px solid var(--gold);color:var(--muted);font-size:15px}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<symbol id="star" viewBox="0 0 100 100"><path fill="currentColor" d="M50 2 60 26 84 16 74 40 98 50 74 60 84 84 60 74 50 98 40 74 16 84 26 60 2 50 26 40 16 16 40 26z"/></symbol>
<symbol id="sofa" viewBox="0 0 200 110"><g fill="currentColor"><rect x="30" y="20" width="140" height="42" rx="14"/><rect x="8" y="42" width="34" height="46" rx="12"/><rect x="158" y="42" width="34" height="46" rx="12"/><rect x="34" y="52" width="132" height="34" rx="10" opacity=".82"/><rect x="40" y="88" width="8" height="14"/><rect x="152" y="88" width="8" height="14"/></g></symbol>
<symbol id="curtain" viewBox="0 0 200 130"><g fill="currentColor"><rect x="14" y="8" width="172" height="6" rx="3"/><path d="M20 14h52c-6 30-4 70 0 108H20zM128 14h52v108h-52c4-38 6-78 0-108z"/><path d="M78 14h44v108H78z" opacity=".18"/></g><g stroke="var(--bg)" stroke-width="2" opacity=".5"><path d="M32 16v104M46 16v104M60 16v104M140 16v104M154 16v104M168 16v104"/></g></symbol>
</defs></svg>

<header><div class="bar">
<a class="brand" href="#top"><svg><use href="#star"/></svg>النجمة للأثاث</a>
<nav aria-label="التنقل">
<a href="#products">المنتجات</a><a href="#curtains">الستائر</a><a href="#about">من نحن</a><a href="#contact">التواصل</a>
</nav></div></header>

<main id="top">
<section class="hero">
<svg class="star" viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>
<div class="rate">★ 4.4 من 5 · ٧ مراجعات</div>
<h1>نصنع جمال منزلك</h1>
<p>كنب ومجالس وستائر مفصّلة على مقاسك، من متجرنا في القمرية بالطائف.</p>
<div class="btns"><a class="btn fill" href="#products">تصفح المنتجات</a><a class="btn" href="#contact">تواصل معنا</a></div>
</section>

<div class="alt"><section style="padding-block:40px">
<div class="cats">
<a class="cat" href="#sofas"><span>🛋️</span><div><h3>الكنب والمجالس</h3><small>جلسات عربية وحديثة</small></div></a>
<a class="cat" href="#curtains"><span>🪟</span><div><h3>الستائر</h3><small>مودرن وفاخرة، تفصيل حسب المقاس</small></div></a>
</div></section></div>

<section id="products">
<h2 id="sofas">الكنب والمجالس</h2>
<p class="lead">اختر القطعة التي تعجبك واطلبها مباشرة عبر واتساب. الأسعار والخامات تُؤكَّد عند الطلب.</p>
<div class="grid" id="sofaGrid"></div>
</section>

<div class="alt" id="curtains"><section>
<h2>الستائر</h2>
<p class="lead">ستائر مودرن وفاخرة بخيارات متعددة للألوان والخامات، ونركّبها في المنازل والمجالس.</p>
<div class="grid" id="curtainGrid"></div>
<h3 style="margin:44px 0 0;font-size:24px">اطلب ستارتك على المقاس</h3>
<div class="tools">
<label>النوع<select id="cType"><option>مودرن</option><option>فاخرة</option></select></label>
<label>العرض (سم)<input id="cW" type="number" inputmode="numeric" min="0" placeholder="مثال: 300"></label>
<label>الارتفاع (سم)<input id="cH" type="number" inputmode="numeric" min="0" placeholder="مثال: 260"></label>
<label>اللون المفضل<input id="cC" type="text" placeholder="مثال: بيج"></label>
</div>
<a class="btn fill" id="cBtn" target="_blank" rel="noopener">اطلب ستارتك الآن</a>
</section></div>

<section id="about">
<h2>من نحن</h2>
<p class="lead">النجمة للأثاث متجر في حي القمرية بالطائف. نختار قطعنا بعناية ونهتم بتفاصيلها.</p>
<div class="about">
<div><h3>جودة المنتجات</h3><p>خامات متينة وتشطيب نظيف، لأن الأثاث يبقى معك سنوات.</p></div>
<div><h3>تصاميم أنيقة</h3><p>خطوط هادئة وألوان دافئة تناسب المجلس والصالة وغرفة المعيشة.</p></div>
<div><h3>تعامل يحترم عميلنا</h3><p>نجيب عن أسئلتك بوضوح، ونفصّل الستائر على مقاس منزلك.</p></div>
</div>
</section>

<div class="alt"><section id="contact">
<h2>التواصل</h2>
<div class="contact">
<dl>
<dt>الهاتف</dt><dd><a href="tel:+966500356530" dir="ltr">+966 50 035 6530</a></dd>
<dt>العنوان</dt><dd>خالد بن الوليد، القمرية، الطائف 26523</dd>
<dt>أوقات العمل</dt><dd id="hours">أوقات العمل تُضاف هنا</dd>
</dl>
<div class="btns" style="margin:0;align-content:start">
<a class="btn fill" id="waBtn" target="_blank" rel="noopener">واتساب مباشر</a>
<a class="btn" href="tel:+966500356530">اتصل الآن</a>
<a class="btn" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=%D8%A7%D9%84%D9%86%D8%AC%D9%85%D8%A9%20%D9%84%D9%84%D8%A3%D8%AB%D8%A7%D8%AB%20%D8%A7%D9%84%D9%82%D9%85%D8%B1%D9%8A%D8%A9%20%D8%A7%D9%84%D8%B7%D8%A7%D8%A6%D9%81">الخريطة</a>
<button class="btn" id="shareBtn" type="button">مشاركة</button>
</div></div>
</section></div>
</main>
<footer>© النجمة للأثاث · الطائف</footer>

<script>
var PHONE="966500356530";
function wa(t){return "https://wa.me/"+PHONE+"?text="+encodeURIComponent(t)}
var sofas=[
{n:"كنب مودرن ٣ مقاعد",p:"السعر عند الطلب",d:"مقاعد عميقة ومسند مريح لجلسة عائلية يومية.",s:"3 متر · 2.4 متر",c:"بيج، رمادي، بني",m:"قماش مخمل",bg:"#E8D9BC",fg:"#8A6A3B"},
{n:"مجلس عربي ركنة",p:"السعر عند الطلب",d:"ركنة واسعة تناسب المجالس وتتسع لعدد كبير من الضيوف.",s:"حسب المساحة",c:"ذهبي، عاجي، كحلي",m:"قماش وخشب",bg:"#EADFC9",fg:"#6B4A24"},
{n:"كنب كلاسيك فاخر",p:"السعر عند الطلب",d:"تفاصيل منحوتة وخشب مذهّب لصالة استقبال أنيقة.",s:"مقاعد ٢ و٣",c:"عاجي، أخضر زيتي",m:"مخمل وخشب زان",bg:"#E3D2AE",fg:"#7A5A1E"},
{n:"طقم جلسة أرضية",p:"السعر عند الطلب",d:"مراتب ومساند مريحة لمجلس تقليدي بلمسة عصرية.",s:"حسب الطلب",c:"بيج، بني، عنابي",m:"قطن وإسفنج عالي الكثافة",bg:"#EDE2CD",fg:"#5C3F1F"}];
var curtains=[
{n:"ستارة مودرن سادة",p:"السعر عند الطلب",d:"خط بسيط وتعليق مستقيم يناسب الغرف الحديثة.",s:"تفصيل حسب المقاس",c:"أبيض، بيج، رمادي",m:"كتان وبلاك أوت",bg:"#E9E0CE",fg:"#9C8A6C"},
{n:"ستارة فاخرة مطرّزة",p:"السعر عند الطلب",d:"قماش ثقيل بتطريز ذهبي للمجالس وصالات الاستقبال.",s:"تفصيل حسب المقاس",c:"ذهبي، عاجي، بني",m:"مخمل وحرير صناعي",bg:"#E5D5B0",fg:"#8A6420"},
{n:"ستارة شيفون مع بلاك أوت",p:"السعر عند الطلب",d:"طبقتان: خفيفة للنهار وأخرى تحجب الضوء عند النوم.",s:"تفصيل حسب المقاس",c:"كريمي، أخضر فاتح",m:"شيفون وبلاك أوت",bg:"#ECE4D2",fg:"#A79A7E"},
{n:"ستارة رول",p:"السعر عند الطلب",d:"عملية وسهلة التنظيف للمطبخ والمكتب وغرف الأطفال.",s:"تفصيل حسب المقاس",c:"بيج، رمادي، أسود",m:"قماش مقاوم للغبار",bg:"#E6DAC4",fg:"#7B6A50"}];
function render(list,id,sym){
document.getElementById(id).innerHTML=list.map(function(x){
return '<article class="card"><div class="pic" style="background:'+x.bg+';color:'+x.fg+'"><svg viewBox="0 0 200 130"><use href="#'+sym+'"/></svg></div><div class="in"><h3>'+x.n+'</h3><div class="price">'+x.p+'</div><p>'+x.d+'</p><div class="spec">المقاسات: '+x.s+'<br>الألوان: '+x.c+'<br>الخامة: '+x.m+'</div><a class="btn" target="_blank" rel="noopener" href="'+wa("السلام عليكم، أرغب بطلب: "+x.n)+'">اطلب الآن عبر واتساب</a></div></article>'}).join("")}
render(sofas,"sofaGrid","sofa");render(curtains,"curtainGrid","curtain");
function upd(){
