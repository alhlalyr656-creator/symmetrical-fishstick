if(navigator.share){navigator.share(d).catch(function(){})}
else if(navigator.clipboard){navigator.clipboard.writeText(location.href).then(function(){shareBtn.textContent="تم نسخ الرابط"}).catch(function(){})}};
</script>
</body>
</html>
