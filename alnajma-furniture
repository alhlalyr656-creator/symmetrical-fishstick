.hero p{color:var(--mute);max-width:520px;margin:0 auto 24px}
.btn{display:inline-block;padding:11px 26px;border-radius:40px;font-weight:700;margin:4px;border:1.5px solid var(--gold)}
.b1{background:var(--gold);color:#fff}.b2{color:var(--gold)}
section{padding:40px 0}
h2{font-size:26px;margin:0 0 6px}
h2::after{content:"";display:block;width:54px;height:3px;background:var(--gold2);margin-top:6px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px;margin-top:22px}
.cat{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px 8px;text-align:center;font-weight:700}
.cat i{display:block;font-style:normal;font-size:34px}
.pg{grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}
.prod{background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden}
.img{height:150px;display:grid;place-items:center;font-size:56px;background:linear-gradient(135deg,var(--line),var(--gold2))}
.prod div.t{padding:14px}
.prod h3{margin:0;font-size:17px}
.prod p{margin:4px 0 10px;color:var(--mute);font-size:13.5px}
.prod .wa{display:block;text-align:center;background:var(--wa);color:#fff;border-radius:10px;padding:8px;font-weight:700;font-size:14px}
.note{font-size:12.5px;color:var(--mute);margin-top:14px}
.about{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px;margin-top:20px}
.feat{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.feat span{background:var(--bg);border:1px solid var(--line);border-radius:30px;padding:4px 16px;font-size:14px}
.contact{display:grid;gap:12px;margin-top:20px}
.row{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 18px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.row b{color:var(--gold)}
footer{text-align:center;padding:26px 0 90px;color:var(--mute);font-size:13px;border-top:1px solid var(--line)}
.float{position:fixed;inset-inline-start:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));background:var(--wa);color:#fff;border-radius:40px;padding:12px 20px;font-weight:700;box-shadow:0 6px 18px rgba(0,0,0,.25);z-index:9}
@media(max-width:520px){nav{display:none}}
</style>
</head>
